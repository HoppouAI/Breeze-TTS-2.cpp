# byte arrays instead of raw strings, msvc wont take a string literal this long
function(embed_file name path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "(................................................................)" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    file(APPEND "${OUT_HEADER}" "static const unsigned char ${name}_bytes[] = {\n${hex}0x00};\n")
    file(APPEND "${OUT_HEADER}" "inline const char * ${name} = reinterpret_cast<const char *>(${name}_bytes);\n\n")
endfunction()

file(WRITE  "${OUT_HEADER}" "// generated by cmake/embed_webui.cmake, do not edit\n")
file(APPEND "${OUT_HEADER}" "#pragma once\n\n")
file(APPEND "${OUT_HEADER}" "namespace breeze_webui {\n\n")
embed_file(index_html "${WEBUI_DIR}/index.html")
embed_file(style_css  "${WEBUI_DIR}/style.css")
embed_file(app_js     "${WEBUI_DIR}/app.js")
file(APPEND "${OUT_HEADER}" "}\n")
